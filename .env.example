APP_NAME=HealthGuard IoT
APP_ENV=development
# Replace this fake placeholder with a randomly generated secret before starting.
SECRET_KEY=change-me-for-local-development
DATABASE_URL=sqlite:///./healthguard.db

# Demo alert configuration
# Academic prototype only — not for clinical use or medical advice
ALERT_HEART_RATE_LOW=60
ALERT_HEART_RATE_HIGH=100
ALERT_SPO2_LOW=95
ALERT_TEMPERATURE_LOW=35.0
ALERT_TEMPERATURE_HIGH=38.0

# Academic fuzzy-logic demo configuration only — not clinically validated
FUZZY_HEART_RATE_TRANSITION_BPM=10
FUZZY_SPO2_TRANSITION_PERCENT=3
FUZZY_TEMPERATURE_TRANSITION_C=0.5
